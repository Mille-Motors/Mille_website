// MILLE — modelo de datos.
//
// Cinco tablas de negocio (AdminUser, Category, Vehicle, VehicleImage,
// Inquiry) más un registro de auditoría. Las credenciales NO viven aquí:
// la identidad la maneja Supabase Auth y esta base solo guarda a quién de
// ese directorio le corresponde el rol de Superadmin.
//
// Las URLs de conexión están en prisma7.config.ts (Prisma 7) y el runtime
// las recibe por el driver adapter en src/server/db/prisma.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enumeraciones
// ---------------------------------------------------------------------------

/// Un carro y una moto son cosas distintas, no dos categorías de la misma
/// lista. El tipo va primero; la categoría vive dentro de él.
enum VehicleType {
  AUTO
  MOTO
}

/// Si el vehículo se puede comprar. Independiente de si está publicado.
enum AvailabilityStatus {
  AVAILABLE
  RESERVED
  SOLD
}

/// Si el vehículo es visible en el sitio público. Independiente de si está
/// disponible: un vehículo vendido puede seguir publicado.
enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// V1 solo necesita SUPERADMIN. El enum existe para poder añadir roles
/// después sin migrar la forma de la columna.
enum AdminRole {
  SUPERADMIN
}

enum InquiryType {
  GENERAL
  VEHICLE_INFO
  APPOINTMENT
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
  SPAM
}

/// De dónde sale el archivo de una imagen. LEGACY son las fotos que ya
/// estaban en /public antes de existir la base de datos: el admin no puede
/// borrarlas del disco, así que se distinguen para no intentarlo.
enum ImageSource {
  LEGACY
  STORAGE
}

/// De qué clase de fuente viene una fotografía, para poder responder por qué
/// MILLE puede usarla. No tiene nada que ver con `ImageSource`, que dice
/// dónde vive el archivo: esto dice de quién es.
///
/// Vocabulario y etiquetas en src/lib/image-provenance.ts.
enum ImageSourceType {
  OWN
  OWNER
  DEALER
  PHOTOGRAPHER
  STOCK
  MANUFACTURER
  OTHER
}

/// Qué autorizó el Titular. Hay uno porque hay uno: ningún flujo del sitio
/// pide aceptar los Términos ni ofrece comunicaciones comerciales. Ver
/// src/lib/consent.ts.
enum ConsentType {
  DATA_PROCESSING
}

/// Qué hizo el Titular. No existe DENIED: sin la casilla marcada el
/// formulario no se envía, así que nunca llega una negativa que registrar.
enum ConsentAction {
  GRANTED
  REVOKED
}

/// Qué derecho ejerce el Titular. Son los del art. 8 de la Ley 1581 de 2012.
enum PrivacyRequestType {
  ACCESS
  UPDATE
  RECTIFICATION
  DELETION
  REVOCATION
  PROOF_OF_CONSENT
  USE_INFORMATION
  COMPLAINT
  OTHER
}

enum PrivacyRequestStatus {
  RECEIVED
  IN_PROGRESS
  NEEDS_INFO
  ANSWERED
  REJECTED
  CLOSED
}

enum PrivacyRequestChannel {
  EMAIL
  WHATSAPP
  OTHER
}

// ---------------------------------------------------------------------------
// Equipo interno
// ---------------------------------------------------------------------------

/// Autorización, no autenticación. La contraseña vive en Supabase Auth y
/// nunca en esta base. `authUserId` enlaza con auth.users.id y se rellena la
/// primera vez que la persona entra, para que conceder el rol funcione aun
/// antes de que el usuario exista en Supabase.
model AdminUser {
  id         String    @id @default(uuid()) @db.Uuid
  authUserId String?   @unique @db.Uuid
  email      String    @unique
  name       String?
  role       AdminRole @default(SUPERADMIN)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  auditLogs AdminAuditLog[]

  @@index([active])
}

// ---------------------------------------------------------------------------
// Taxonomía
// ---------------------------------------------------------------------------

/// La CARROCERÍA de un vehículo, administrable desde /admin/categorias.
///
/// `name` es singular porque describe un vehículo ("Sedán"); `pluralName` es
/// como se lee en las superficies de navegación ("Sedanes"). El slug es
/// identidad: viaja en `?categoria=` y no se cambia a la ligera.
///
/// Conjunto canónico de arranque: src/lib/body-types.ts. Ahí NO están
/// "Híbrido", "Eléctrico", "Deportivo" ni "4x4", porque no son carrocerías:
/// son propulsión, carácter y tracción, y cada uno tiene su propia columna.
model Category {
  name        String
  pluralName  String
  slug        String
  vehicleType VehicleType
  active      Boolean     @default(true)
  position    Int         @default(0)
  id          String      @id @default(uuid()) @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  vehicles Vehicle[]

  @@unique([vehicleType, slug])
  @@unique([vehicleType, name])
  @@index([vehicleType, position])
}

// ---------------------------------------------------------------------------
// Inventario
// ---------------------------------------------------------------------------

/// `price` es BigInt: los precios están en pesos colombianos enteros y los
/// valores altos del inventario ya rozan el límite de Int4. Se convierte a
/// number en la capa de mapeo, muy por debajo de MAX_SAFE_INTEGER.
///
/// `fuelType`, `transmission`, `drivetrain` y el resto de vocabularios
/// cerrados son texto y no enums de Postgres: sus etiquetas llevan tildes y
/// paréntesis ("Integral (AWD)", "Híbrido ligero (MHEV)"), y el conjunto
/// válido se valida con Zod contra las mismas uniones que usa la interfaz,
/// en src/types/vehicle.ts. Ampliar la lista no exige entonces una migración.
///
/// Todo lo técnico avanzado es NULLABLE a propósito. Un vehículo del que no
/// conocemos el torque tiene torque desconocido, no torque cero: la ficha
/// pública oculta lo que es null en vez de escribir "N/A", y ese es el único
/// modo de que MILLE pueda ser muy completa sin llegar a inventar un dato.
///
/// Las columnas viven en `Vehicle` y no en tablas 1:1 por sección. Un
/// vehículo tiene exactamente un motor y una situación documental; separarlo
/// costaría tres joins en cada consulta para no distinguir nada, porque
/// "fila ausente" y "todas las columnas en null" son el mismo hecho. En
/// Postgres las columnas nulas ocupan un bit del mapa de nulos de la fila.
model Vehicle {
  id      String @id @default(uuid()) @db.Uuid
  slug    String @unique
  version String @default("")

  /// Un BORRADOR puede estar incompleto, y eso no es un defecto del modelo:
  /// es lo que significa `DRAFT`.
  ///
  /// La regla es que NADA del vehículo se afirma hasta que alguien lo elige.
  /// Un borrador creado solo para poder subir la foto de un 330e no puede
  /// existir como "Gasolina + AWD + SUV" porque esos fueran los primeros
  /// valores de cada lista: sería un dato inventado guardado en la base,
  /// exactamente lo que este proyecto no hace en ninguna otra parte.
  ///
  /// Por eso carrocería, combustible, transmisión, tracción, ciudad, año,
  /// precio y kilometraje admiten NULL, que se lee "todavía no se sabe";
  /// marca, modelo y descripción admiten la cadena vacía, igual que ya hacían
  /// `version`, `engine` y los colores.
  ///
  /// La distinción NULL / 0 importa en kilometraje: 0 km es un valor legítimo
  /// —un importado nuevo—, así que no puede servir de marcador de "sin
  /// rellenar".
  ///
  /// `vehicleType` es la excepción, y es deliberada: no es un dato técnico
  /// sino el universo al que pertenece la ficha —carro o moto—, y de él
  /// dependen qué carrocerías se ofrecen y en qué listado aparece. Elegirlo
  /// no afirma nada sobre la mecánica del vehículo.
  ///
  /// Nada de esto relaja la publicación: `publicationBlockers()` los exige
  /// todos, y `assertPublishedInvariant()` lo comprueba dentro de cada
  /// transacción que pueda romperlo. Incompleto se puede guardar; publicado,
  /// nunca.
  vehicleType VehicleType
  make        String  @default("")
  model       String  @default("")
  year        Int?
  price       BigInt?
  mileage     Int?

  /// La CARROCERÍA. El nombre de la relación se conserva porque es el de la
  /// tabla y el del parámetro `?categoria=` que ya viaja en enlaces
  /// compartidos; en la interfaz se titula siempre "Carrocería".
  ///
  /// Opcional porque un borrador puede no tenerla elegida. No se inventa una
  /// categoría "Pendiente" para esquivarlo: una carrocería falsa en la tabla
  /// de taxonomía contaminaría los filtros, la navegación y la portada.
  categoryId String?   @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  fuelType      String?
  /// Vocabulario propio de cada universo: ver `transmissionsFor()`.
  transmission  String?
  /// Número de marchas. Opcional y sin valor por defecto en ninguno de los
  /// dos universos: "seis" es lo habitual en moto, pero habitual no es sabido.
  gearCount     Int?
  /// Solo carros (FWD/RWD/AWD/4WD). En una moto queda nulo.
  drivetrain    String?
  /// Solo motos: cadena, correa, cardán. Es lo que una ficha de moto publica
  /// y lo que sustituye al selector de tracción en ese universo.
  finalDrive    String?
  /// Nombre del motor tal como se lee: "3.0 L I6 TwinPower Turbo".
  engine        String  @default("")
  exteriorColor String  @default("")
  interiorColor String  @default("")
  city          String?

  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  publicationStatus  PublicationStatus  @default(DRAFT)
  featured           Boolean            @default(false)

  description String @default("")

  // --- Motor -------------------------------------------------------------
  engineLayout   String?
  cylinders      Int?
  displacementCc Int?
  aspiration     String?

  // --- Prestaciones ------------------------------------------------------
  /// Potencia del sistema: combinada en un híbrido, total en un eléctrico.
  powerHp            Int?
  torqueNm           Int?
  /// Segundos. Float porque 5,6 s no es 5 s ni 6 s.
  accel0100          Float?
  topSpeedKph        Int?
  topSpeedLimited    Boolean @default(false)
  /// El tope real cuando el limitador no coincide con la punta declarada.
  topSpeedLimitedKph Int?
  /// Peso en orden de marcha. La relación peso/potencia se calcula, no se pide.
  curbWeightKg       Int?

  // --- Sistema híbrido / eléctrico ---------------------------------------
  icePowerHp          Int?
  iceTorqueNm         Int?
  electricMotorCount  Int?
  electricPowerHp     Int?
  electricTorqueNm    Int?
  electricMotorLayout String?
  hybridSystem        String?
  batteryGrossKwh     Float?
  batteryNetKwh       Float?
  electricRangeKm     Int?
  /// WLTP, EPA, CLTC… Una autonomía sin su ciclo no se puede comparar.
  rangeStandard       String?
  chargeAcKw          Float?
  chargeDcKw          Float?
  chargeConnector     String?
  chargeTimeNote      String?

  // --- Documentación y matrícula -----------------------------------------
  /// `@db.Date` y no timestamp: un vencimiento de SOAT es un día del
  /// calendario. Guardarlo como instante lo corría un día al leerlo en Bogotá.
  registrationCity        String?
  /// Cómo termina la placa, en texto. En carro es un dígito —lo que mira el
  /// pico y placa—; en moto los formatos colombianos han cambiado con los
  /// años, así que se acepta alfanumérico en vez de imponer una forma.
  plateEnding             String?
  soatValid               Boolean?
  soatExpiresOn           DateTime? @db.Date
  /// `false` es una respuesta: hay vehículos a los que todavía no les aplica.
  techInspectionApplies   Boolean?
  techInspectionExpiresOn DateTime? @db.Date
  taxStatus               String?
  /// Año, no fecha: el impuesto vehicular colombiano es anual.
  taxesPaidThroughYear    Int?
  documentationCheckedOn  DateTime? @db.Date
  documentationNotes      String?

  // --- Editorial ---------------------------------------------------------
  /// Apagado no reserva espacio ni exige texto en ninguna de las dos caras.
  funFactEnabled Boolean @default(false)
  funFactTitle   String?
  funFactBody    String?

  // --- Equipamiento y carácter -------------------------------------------
  /// El equipamiento, una línea por elemento y en orden.
  ///
  /// Era un catálogo cerrado de ochenta y cuatro casillas más una lista de
  /// texto libre al lado. Buscar una opción entre decenas de checkboxes era
  /// peor que escribirla, y el catálogo no podía describir una suspensión
  /// Skyhook ni unas pinzas Brembo Stylema. Ahora es texto, con líneas
  /// `[Sección]` que agrupan, y el formulario ofrece una plantilla distinta
  /// para carro y para moto.
  equipment        String[] @default([])
  /// [{ name, description }]. Opciones destacadas de ESTA unidad.
  specialEquipment Json     @default("[]")
  /// Carácter del vehículo: Deportivo, Off-road, Lujo… Nunca carrocería.
  tags             String[] @default([])

  /// Lo que una migración no pudo decidir sola. Se muestra en el admin como
  /// aviso; el sitio público no lo lee nunca.
  reviewNote String?

  // --- Procedencia del LOTE fotográfico ----------------------------------
  /// De dónde salieron las fotos de ESTE vehículo, y por qué se pueden usar.
  ///
  /// Va en el vehículo porque así llegan las fotos de un carro: las
  /// veinticuatro del mismo propietario, o todas del dealer. Pedir diez
  /// campos por fotografía garantizaría que nadie registrara ninguna, y una
  /// procedencia que nadie rellena no documenta nada. `VehicleImage` lleva
  /// las mismas columnas para la fotografía que venga de otra parte, y
  /// entonces manda la de la fotografía: ver `resolveImageRights()`.
  ///
  /// `rightsSourceType` es el interruptor. Nulo significa «nadie lo ha
  /// registrado», y eso NO bloquea nada: ni la publicación, ni la subida, ni
  /// el sitio público. Las fotos que ya están publicadas no reciben una
  /// autorización inventada por el hecho de existir.
  rightsSourceType                 ImageSourceType?
  rightsSourceName                 String?
  rightsAuthor                     String?
  rightsSourceUrl                  String?
  rightsLicenseType                String?
  rightsLicenseUrl                 String?
  /// Si la licencia EXIGE citar al autor donde se publique la fotografía.
  /// Ninguna de las que usa el sitio hoy lo exige, así que el público no ve
  /// créditos; el Admin sí lo dice.
  rightsLicenseRequiresAttribution Boolean          @default(false)
  /// `@db.Date` por lo mismo que el SOAT: es un día del calendario.
  rightsAcquiredOn                 DateTime?        @db.Date
  rightsAuthorizedBy               String?
  /// No guarda la prueba: la señala. Un hilo de correo, un contrato, un
  /// archivo. La prueba se queda donde esté; aquí queda cómo encontrarla.
  rightsProofRef                   String?
  rightsNotes                      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  images          VehicleImage[]
  imageUploads    VehicleImageUpload[]
  inquiries       Inquiry[]

  @@index([publicationStatus])
  @@index([vehicleType])
  @@index([make])
  @@index([model])
  @@index([categoryId])
  @@index([updatedAt])
  @@index([publicationStatus, createdAt])
  @@index([featured])
  @@index([availabilityStatus])
  @@index([year])
  @@index([price])
  @@index([mileage])
  @@index([fuelType])
  @@index([drivetrain])
  @@index([city])
  /// GIN: `tags @> ARRAY['Deportivo']` es la forma del filtro por carácter.
  /// `features` no lleva índice porque nada lo consulta: se lee con la ficha.
  @@index([tags], type: Gin)
}

/// `url` es lo que renderiza el sitio. `storagePath` solo existe para las
/// imágenes subidas a Supabase Storage, que son las únicas que el admin
/// puede borrar del bucket. `position` 0 es la portada.
model VehicleImage {
  id          String      @id @default(uuid()) @db.Uuid
  vehicleId   String      @db.Uuid
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url         String
  /// Único: un mismo objeto del bucket no puede quedar registrado dos veces.
  /// Las imágenes LEGACY viven en /public y no tienen ruta, y en Postgres
  /// varios NULL no chocan entre sí, así que la restricción no las afecta.
  storagePath String?     @unique
  source      ImageSource @default(STORAGE)
  alt         String
  position    Int         @default(0)
  /// Qué parte de la fotografía permanece visible dentro del marco
  /// horizontal del sitio, en porcentaje: 0 izquierda/arriba, 50 centro,
  /// 100 derecha/abajo. No se recorta ningún archivo — el original sigue
  /// entero en Storage— y el recorte lo hace el navegador con
  /// `object-fit: cover` más `object-position`, igual que en SiteMedia.
  /// El centro es como se veía el inventario antes de que esto existiera,
  /// así que una foto que nadie haya encuadrado no cambia de aspecto.
  focalX      Float       @default(50)
  focalY      Float       @default(50)
  createdAt   DateTime    @default(now())

  /// La procedencia de ESTA fotografía, cuando no es la del lote.
  ///
  /// Nula en la inmensa mayoría de las filas, que es lo normal: una foto
  /// hereda la procedencia de su vehículo y solo se rellena aquí la que
  /// viene de otra parte —la del fabricante entre las del propietario—. En
  /// Postgres una columna nula ocupa un bit del mapa de nulos de la fila,
  /// así que tener las diez aquí no cuesta lo que parece y evita una tabla
  /// 1:1 en la que «fila ausente» y «todo nulo» serían el mismo hecho.
  rightsSourceType                 ImageSourceType?
  rightsSourceName                 String?
  rightsAuthor                     String?
  rightsSourceUrl                  String?
  rightsLicenseType                String?
  rightsLicenseUrl                 String?
  rightsLicenseRequiresAttribution Boolean          @default(false)
  rightsAcquiredOn                 DateTime?        @db.Date
  rightsAuthorizedBy               String?
  rightsProofRef                   String?
  rightsNotes                      String?

  @@unique([vehicleId, position])
  @@index([vehicleId])
}

/// Una ruta reservada para que el navegador suba directo a Storage.
///
/// Existe para que la finalización pueda DEMOSTRAR que la ruta salió de
/// nuestra propia reserva. Comprobar solo el prefijo limitaba el daño pero
/// no probaba nada: cualquiera con la sesión podía inventarse
/// `vehicles/<id>/loquesea.jpg` y pedir que se registrara.
///
/// La fila se borra al consumirla, así que una reserva vale exactamente una
/// vez. `storagePath` es único y la clave ajena va en cascada: borrar el
/// vehículo se lleva sus reservas pendientes.
model VehicleImageUpload {
  id          String   @id @default(uuid()) @db.Uuid
  vehicleId   String   @db.Uuid
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  storagePath String   @unique
  /// Lo que el navegador declaró al reservar. Si los bytes que suben no
  /// coinciden, se rechaza: un PNG no puede acabar servido como JPEG.
  contentType String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([vehicleId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Solicitudes del público
// ---------------------------------------------------------------------------

/// `vehicleId` usa SetNull: archivar o borrar un vehículo nunca debe
/// destruir el registro de quién preguntó por él, así que se conserva
/// `vehicleLabel` con el nombre tal como se mostraba al enviarse.
model Inquiry {
  id           String        @id @default(uuid()) @db.Uuid
  type         InquiryType
  status       InquiryStatus @default(NEW)
  vehicleId    String?       @db.Uuid
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleLabel String?
  name         String
  phone        String?
  email        String?
  message      String?
  /// Página desde la que se envió: "contacto", "vehiculo:<slug>".
  source       String?
  consent      ConsentRecord?
  consentEvents ConsentEvent[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([vehicleId])
}

/// CONGELADA. La primera forma de la prueba de autorización.
///
/// No la escribe nadie: `ConsentEvent` la sustituyó porque un `accepted =
/// true` con la versión de la política no permite reconstruir QUÉ texto se
/// mostró, no registra la revocatoria y se puede editar. Sus filas se
/// copiaron a `ConsentEvent` en la migración 20261019120000 y el Admin lee
/// solo de allí.
///
/// La tabla se queda, y es deliberado: tirarla destruiría la prueba original
/// de autorizaciones reales —lo único que no se puede reponer— para no
/// ganar nada, y además rompería el envío de formularios durante los minutos
/// en que el código viejo y el esquema nuevo coexisten en un despliegue.
/// Sigue en el esquema para que la base y Prisma no divergan.
model ConsentRecord {
  id                   String   @id @default(uuid()) @db.Uuid
  inquiryId            String   @unique @db.Uuid
  inquiry              Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  consentType          String   @default("privacy_treatment")
  accepted             Boolean  @default(true)
  privacyPolicyVersion String
  source               String
  acceptedAt           DateTime @default(now()) @db.Timestamptz(6)

  @@index([acceptedAt])
}

/// Una decisión del Titular sobre sus datos. APPEND-ONLY.
///
/// Es evidencia, no estado: nada se corrige aquí. Revocar no cambia la fila
/// que dice que autorizó —eso sería borrar lo que pasó—, escribe una fila
/// nueva con `action = REVOKED`. El estado vigente de alguien es su último
/// evento, y la historia completa sigue estando.
///
/// El append-only lo impone la BASE, con un trigger, y no la confianza en
/// que ningún código escriba un UPDATE: ver la migración. La única
/// modificación admitida es poner `inquiryId` a NULL, que es lo que hace la
/// clave ajena cuando se borra la solicitud.
///
/// Qué se guarda y por qué: el art. 12 de la Ley 527 de 1999 da por
/// conservado un mensaje de datos cuando la información es accesible, se
/// conserva en un formato que reproduce con exactitud lo generado y se
/// guardan origen, destino, fecha y hora. De ahí salen `textSnapshot`,
/// `textHash`, `source`, `ipAddress` y `createdAt`.
model ConsentEvent {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// La solicitud a la que acompañó. `SetNull` y no `Cascade`: borrar una
  /// solicitud no puede destruir la prueba de que hubo una autorización, y
  /// a la vez un titular que pide supresión deja de estar enlazado a ella.
  /// El evento sobrevive sin identificar a nadie, que es lo correcto: prueba
  /// que hubo una autorización de esta versión a esta hora desde este
  /// formulario, sin conservar a quién ya pidió desaparecer.
  inquiryId String?  @db.Uuid
  inquiry   Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  consentType ConsentType
  action      ConsentAction

  /// Desde dónde: "contacto", "vehiculo:<slug>", "admin".
  source String

  /// La versión de la política vigente cuando se otorgó.
  policyVersion String

  /// El identificador del texto exacto —"data_processing@2026-10-19"—, su
  /// huella SHA-256 y el texto literal que se mostró.
  ///
  /// Los tres admiten NULL por UNA razón: las filas copiadas de
  /// `ConsentRecord` no los tienen, porque cuando se guardaron no se
  /// registraba el texto. Nulo se lee «prueba del texto no disponible», que
  /// es la verdad, y no se rellena con el texto de hoy: eso sería fabricar
  /// una prueba de que alguien leyó algo que no existía. Todo evento nuevo
  /// los trae siempre.
  textVersion  String?
  textHash     String?
  textSnapshot String?

  /// La IP del cliente, obtenida SIEMPRE en el servidor desde las cabeceras
  /// del proxy. Nunca de un campo del formulario: una IP que manda el
  /// navegador no prueba nada. `ipSource` dice de qué cabecera salió, que es
  /// lo que permite saber después cuánto vale.
  ipAddress String?
  ipSource  String?

  userAgent String?
  /// `x-vercel-id`: correlaciona el evento con la traza de la petición.
  requestId String?

  metadata Json?

  @@index([createdAt])
  @@index([consentType, action])
  @@index([source])
  @@index([inquiryId])
}

/// Una solicitud con la que un Titular ejerce sus derechos.
///
/// Separada de `Inquiry` a propósito: «quiero vender mi Porsche» y «quiero
/// que eliminen mis datos» llegan por el mismo WhatsApp y no son lo mismo.
/// La segunda tiene un plazo legal que se vence —diez días hábiles para una
/// consulta, quince para un reclamo— y en una bandeja de clientes se pierde.
///
/// Esta sí se edita: es el expediente del trámite, no la evidencia de una
/// decisión. Lo que no se pierde es quién lo tocó, que queda en
/// `AdminAuditLog`.
model PrivacyRequest {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt

  type    PrivacyRequestType
  status  PrivacyRequestStatus  @default(RECEIVED)
  channel PrivacyRequestChannel

  /// El día en que el titular la presentó, no el día en que se registró: el
  /// plazo se cuenta desde el recibo. `@db.Date` porque es un día.
  receivedOn DateTime @db.Date
  /// Vencimiento calculado en días hábiles colombianos. Se guarda y no se
  /// recalcula al leer para que cambiar la tabla de festivos no mueva el
  /// plazo de un trámite ya abierto.
  dueOn      DateTime @db.Date

  /// Lo mínimo para poder atenderla y poder responder. Al menos uno de los
  /// dos canales tiene que venir: sin forma de contestar, el trámite no se
  /// puede cumplir.
  titularName  String
  titularEmail String?
  titularPhone String?

  /// El art. 20 del Decreto 1377 de 2013 exige acreditar la identidad del
  /// titular —o la representación— antes de entregar o borrar datos. El
  /// booleano no es burocracia: atender una supresión sin verificar quién la
  /// pide es borrarle los datos a alguien a petición de un tercero.
  identityVerified Boolean @default(false)
  identityNote     String?

  /// Qué pidió, en sus palabras.
  subject  String?
  notes    String?
  response String?

  closedAt DateTime? @db.Timestamptz(6)

  @@index([status, dueOn])
  @@index([createdAt])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Imágenes estructurales del sitio público
// ---------------------------------------------------------------------------

/// Las fotografías de la home que no pertenecen a ningún vehículo: el hero y
/// las tres de la historia de MILLE.
///
/// No es un CMS. `key` es una clave fija definida en src/lib/site-media.ts;
/// el admin cambia la fotografía de un slot existente, no crea slots. Una
/// fila que no corresponda a una clave conocida se ignora.
///
/// Solo existe fila para los slots que alguien ya cambió: mientras un slot
/// siga con su imagen original, el sitio la lee del registro en código. Por
/// eso ninguna fila es obligatoria y quedarse sin base de datos no deja la
/// home sin fotos.
/// Una fotografía estructural del sitio: portada, historia, menú, 404…
///
/// Las columnas sin prefijo son la variante de ESCRITORIO, que es la única
/// obligatoria. `mobile*` es una segunda fotografía opcional para cuando el
/// teléfono recorta tan distinto que una sola composición no sirve: si es
/// nula, el teléfono usa la de escritorio con su propio encuadre.
model SiteMedia {
  id          String      @id @default(uuid()) @db.Uuid
  key         String      @unique
  url         String
  storagePath String?
  source      ImageSource @default(STORAGE)
  alt         String
  /// Qué parte de la fotografía debe permanecer visible cuando el marco la
  /// recorta, en porcentaje: 0 izquierda/arriba, 50 centro, 100 derecha/abajo.
  /// El centro es el valor con el que se construyó el sitio, así que una fila
  /// que nunca se haya encuadrado se sigue viendo exactamente igual.
  focalX      Float       @default(50)
  focalY      Float       @default(50)

  /// Lo que mide y pesa el archivo de escritorio. Nulo en las filas que
  /// siguen apuntando a /public y en las que se subieron antes de que esto
  /// existiera: el Admin lo mide entonces en el navegador.
  width       Int?
  height      Int?
  bytes       Int?
  contentType String?

  /// La variante de teléfono. Toda nula mientras nadie suba una: el sitio
  /// funciona igual, usando la de escritorio.
  mobileUrl         String?
  mobileStoragePath String?
  mobileWidth       Int?
  mobileHeight      Int?
  mobileBytes       Int?
  mobileContentType String?
  /// El encuadre de teléfono. Existe SIEMPRE, haya variante propia o no:
  /// elegir qué parte se ve en vertical es útil aunque el archivo sea el
  /// mismo. Arranca en el centro, que es como se veía antes.
  mobileFocalX      Float   @default(50)
  mobileFocalY      Float   @default(50)

  /// La procedencia de la fotografía de este espacio.
  ///
  /// Una fila que sigue apuntando a `/public` no la necesita: la procedencia
  /// de un archivo del repositorio está en el repositorio
  /// —`REPOSITORY_IMAGE_RIGHTS`, generado de los CREDITS.json— y copiarla
  /// aquí solo crearía dos verdades que se pueden desincronizar. Estas
  /// columnas son para lo que alguien SUBE, que es lo que nadie más puede
  /// saber. Cubren las dos variantes del espacio: la de teléfono es un
  /// recorte distinto de la misma sesión, no otra fotografía con otros
  /// derechos.
  rightsSourceType                 ImageSourceType?
  rightsSourceName                 String?
  rightsAuthor                     String?
  rightsSourceUrl                  String?
  rightsLicenseType                String?
  rightsLicenseUrl                 String?
  rightsLicenseRequiresAttribution Boolean          @default(false)
  rightsAcquiredOn                 DateTime?        @db.Date
  rightsAuthorizedBy               String?
  rightsProofRef                   String?
  rightsNotes                      String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Medición
// ---------------------------------------------------------------------------

/// Un clic al botón de WhatsApp del sitio. Sirve para saber si el botón se
/// usa, desde dónde y qué vehículos mueven más preguntas; no para seguir a
/// nadie, y por eso la fila NO guarda IP, agente de usuario ni identificador
/// de persona: solo qué se tocó y en qué página.
///
/// `vehicleSlug` es texto y no una clave ajena a propósito: el conteo tiene
/// que sobrevivir a que el vehículo se archive o se borre, y un vehículo que
/// ya no existe sigue habiendo recibido esas preguntas.
///
/// La escribe EXCLUSIVAMENTE el backend (POST /api/whatsapp-click) y la lee el
/// dashboard del admin; ver la migración para el endurecimiento de la Data API.
model WhatsappClick {
  id          String   @id @default(uuid()) @db.Uuid
  /// De qué enlace salió: ver WHATSAPP_CLICK_SOURCES en src/lib/whatsapp-click.ts.
  source      String
  /// Qué quería la persona: general, buscar, vender, cita o vehículo.
  intent      String?
  vehicleSlug String?
  /// Página donde estaba, sin parámetros.
  path        String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([vehicleSlug, createdAt])
}

// ---------------------------------------------------------------------------
// Auditoría
// ---------------------------------------------------------------------------

/// Quién hizo qué. `adminUserId` es opcional para que revocar a alguien del
/// equipo no borre su historial.
model AdminAuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  adminUserId String?    @db.Uuid
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  adminEmail  String
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
