// MILLE — modelo de datos.
//
// Cinco tablas de negocio (AdminUser, Category, Vehicle, VehicleImage,
// Inquiry) más un registro de auditoría. Las credenciales NO viven aquí:
// la identidad la maneja Supabase Auth y esta base solo guarda a quién de
// ese directorio le corresponde el rol de Superadmin.
//
// Las URLs de conexión están en prisma7.config.ts (Prisma 7) y el runtime
// las recibe por el driver adapter en src/server/db/prisma.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enumeraciones
// ---------------------------------------------------------------------------

/// Un carro y una moto son cosas distintas, no dos categorías de la misma
/// lista. El tipo va primero; la categoría vive dentro de él.
enum VehicleType {
  AUTO
  MOTO
}

/// Si el vehículo se puede comprar. Independiente de si está publicado.
enum AvailabilityStatus {
  AVAILABLE
  RESERVED
  SOLD
}

/// Si el vehículo es visible en el sitio público. Independiente de si está
/// disponible: un vehículo vendido puede seguir publicado.
enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// V1 solo necesita SUPERADMIN. El enum existe para poder añadir roles
/// después sin migrar la forma de la columna.
enum AdminRole {
  SUPERADMIN
}

enum InquiryType {
  GENERAL
  VEHICLE_INFO
  APPOINTMENT
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
  SPAM
}

/// De dónde sale el archivo de una imagen. LEGACY son las fotos que ya
/// estaban en /public antes de existir la base de datos: el admin no puede
/// borrarlas del disco, así que se distinguen para no intentarlo.
enum ImageSource {
  LEGACY
  STORAGE
}

// ---------------------------------------------------------------------------
// Equipo interno
// ---------------------------------------------------------------------------

/// Autorización, no autenticación. La contraseña vive en Supabase Auth y
/// nunca en esta base. `authUserId` enlaza con auth.users.id y se rellena la
/// primera vez que la persona entra, para que conceder el rol funcione aun
/// antes de que el usuario exista en Supabase.
model AdminUser {
  id         String    @id @default(uuid()) @db.Uuid
  authUserId String?   @unique @db.Uuid
  email      String    @unique
  name       String?
  role       AdminRole @default(SUPERADMIN)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  auditLogs AdminAuditLog[]

  @@index([active])
}

// ---------------------------------------------------------------------------
// Taxonomía
// ---------------------------------------------------------------------------

/// La CARROCERÍA de un vehículo, administrable desde /admin/categorias.
///
/// `name` es singular porque describe un vehículo ("Sedán"); `pluralName` es
/// como se lee en las superficies de navegación ("Sedanes"). El slug es
/// identidad: viaja en `?categoria=` y no se cambia a la ligera.
///
/// Conjunto canónico de arranque: src/lib/body-types.ts. Ahí NO están
/// "Híbrido", "Eléctrico", "Deportivo" ni "4x4", porque no son carrocerías:
/// son propulsión, carácter y tracción, y cada uno tiene su propia columna.
model Category {
  name        String
  pluralName  String
  slug        String
  vehicleType VehicleType
  active      Boolean     @default(true)
  position    Int         @default(0)
  id          String      @id @default(uuid()) @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  vehicles Vehicle[]

  @@unique([vehicleType, slug])
  @@unique([vehicleType, name])
  @@index([vehicleType, position])
}

// ---------------------------------------------------------------------------
// Inventario
// ---------------------------------------------------------------------------

/// `price` es BigInt: los precios están en pesos colombianos enteros y los
/// valores altos del inventario ya rozan el límite de Int4. Se convierte a
/// number en la capa de mapeo, muy por debajo de MAX_SAFE_INTEGER.
///
/// `fuelType`, `transmission`, `drivetrain` y el resto de vocabularios
/// cerrados son texto y no enums de Postgres: sus etiquetas llevan tildes y
/// paréntesis ("Integral (AWD)", "Híbrido ligero (MHEV)"), y el conjunto
/// válido se valida con Zod contra las mismas uniones que usa la interfaz,
/// en src/types/vehicle.ts. Ampliar la lista no exige entonces una migración.
///
/// Todo lo técnico avanzado es NULLABLE a propósito. Un vehículo del que no
/// conocemos el torque tiene torque desconocido, no torque cero: la ficha
/// pública oculta lo que es null en vez de escribir "N/A", y ese es el único
/// modo de que MILLE pueda ser muy completa sin llegar a inventar un dato.
///
/// Las columnas viven en `Vehicle` y no en tablas 1:1 por sección. Un
/// vehículo tiene exactamente un motor y una situación documental; separarlo
/// costaría tres joins en cada consulta para no distinguir nada, porque
/// "fila ausente" y "todas las columnas en null" son el mismo hecho. En
/// Postgres las columnas nulas ocupan un bit del mapa de nulos de la fila.
model Vehicle {
  id      String @id @default(uuid()) @db.Uuid
  slug    String @unique
  version String @default("")

  /// Un BORRADOR puede estar incompleto, y eso no es un defecto del modelo:
  /// es lo que significa `DRAFT`.
  ///
  /// La regla es que NADA del vehículo se afirma hasta que alguien lo elige.
  /// Un borrador creado solo para poder subir la foto de un 330e no puede
  /// existir como "Gasolina + AWD + SUV" porque esos fueran los primeros
  /// valores de cada lista: sería un dato inventado guardado en la base,
  /// exactamente lo que este proyecto no hace en ninguna otra parte.
  ///
  /// Por eso carrocería, combustible, transmisión, tracción, ciudad, año,
  /// precio y kilometraje admiten NULL, que se lee "todavía no se sabe";
  /// marca, modelo y descripción admiten la cadena vacía, igual que ya hacían
  /// `version`, `engine` y los colores.
  ///
  /// La distinción NULL / 0 importa en kilometraje: 0 km es un valor legítimo
  /// —un importado nuevo—, así que no puede servir de marcador de "sin
  /// rellenar".
  ///
  /// `vehicleType` es la excepción, y es deliberada: no es un dato técnico
  /// sino el universo al que pertenece la ficha —carro o moto—, y de él
  /// dependen qué carrocerías se ofrecen y en qué listado aparece. Elegirlo
  /// no afirma nada sobre la mecánica del vehículo.
  ///
  /// Nada de esto relaja la publicación: `publicationBlockers()` los exige
  /// todos, y `assertPublishedInvariant()` lo comprueba dentro de cada
  /// transacción que pueda romperlo. Incompleto se puede guardar; publicado,
  /// nunca.
  vehicleType VehicleType
  make        String  @default("")
  model       String  @default("")
  year        Int?
  price       BigInt?
  mileage     Int?

  /// La CARROCERÍA. El nombre de la relación se conserva porque es el de la
  /// tabla y el del parámetro `?categoria=` que ya viaja en enlaces
  /// compartidos; en la interfaz se titula siempre "Carrocería".
  ///
  /// Opcional porque un borrador puede no tenerla elegida. No se inventa una
  /// categoría "Pendiente" para esquivarlo: una carrocería falsa en la tabla
  /// de taxonomía contaminaría los filtros, la navegación y la portada.
  categoryId String?   @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  fuelType      String?
  transmission  String?
  drivetrain    String?
  /// Nombre del motor tal como se lee: "3.0 L I6 TwinPower Turbo".
  engine        String  @default("")
  exteriorColor String  @default("")
  interiorColor String  @default("")
  city          String?

  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  publicationStatus  PublicationStatus  @default(DRAFT)
  featured           Boolean            @default(false)

  description String @default("")

  // --- Motor -------------------------------------------------------------
  engineLayout   String?
  cylinders      Int?
  displacementCc Int?
  aspiration     String?

  // --- Prestaciones ------------------------------------------------------
  /// Potencia del sistema: combinada en un híbrido, total en un eléctrico.
  powerHp            Int?
  torqueNm           Int?
  /// Segundos. Float porque 5,6 s no es 5 s ni 6 s.
  accel0100          Float?
  topSpeedKph        Int?
  topSpeedLimited    Boolean @default(false)
  /// El tope real cuando el limitador no coincide con la punta declarada.
  topSpeedLimitedKph Int?
  /// Peso en orden de marcha. La relación peso/potencia se calcula, no se pide.
  curbWeightKg       Int?

  // --- Sistema híbrido / eléctrico ---------------------------------------
  icePowerHp          Int?
  iceTorqueNm         Int?
  electricMotorCount  Int?
  electricPowerHp     Int?
  electricTorqueNm    Int?
  electricMotorLayout String?
  hybridSystem        String?
  batteryGrossKwh     Float?
  batteryNetKwh       Float?
  electricRangeKm     Int?
  /// WLTP, EPA, CLTC… Una autonomía sin su ciclo no se puede comparar.
  rangeStandard       String?
  chargeAcKw          Float?
  chargeDcKw          Float?
  chargeConnector     String?
  chargeTimeNote      String?

  // --- Documentación y matrícula -----------------------------------------
  /// `@db.Date` y no timestamp: un vencimiento de SOAT es un día del
  /// calendario. Guardarlo como instante lo corría un día al leerlo en Bogotá.
  registrationCity        String?
  plateLastDigit          Int?
  soatValid               Boolean?
  soatExpiresOn           DateTime? @db.Date
  /// `false` es una respuesta: hay vehículos a los que todavía no les aplica.
  techInspectionApplies   Boolean?
  techInspectionExpiresOn DateTime? @db.Date
  taxStatus               String?
  /// Año, no fecha: el impuesto vehicular colombiano es anual.
  taxesPaidThroughYear    Int?
  documentationCheckedOn  DateTime? @db.Date
  documentationNotes      String?

  // --- Editorial ---------------------------------------------------------
  /// Apagado no reserva espacio ni exige texto en ninguna de las dos caras.
  funFactEnabled Boolean @default(false)
  funFactTitle   String?
  funFactBody    String?

  // --- Equipamiento y carácter -------------------------------------------
  /// Claves del catálogo de src/lib/equipment-catalog.ts. Arreglo y no cien
  /// columnas booleanas ni tabla de unión: ver el comentario de ese archivo.
  features         String[] @default([])
  /// Equipamiento adicional en texto libre. Lista ordenada; text[] conserva
  /// el orden sin necesidad de otra tabla.
  equipment        String[] @default([])
  /// [{ name, description }]. Opciones destacadas de ESTA unidad.
  specialEquipment Json     @default("[]")
  /// Carácter del vehículo: Deportivo, Off-road, Lujo… Nunca carrocería.
  tags             String[] @default([])

  /// Lo que una migración no pudo decidir sola. Se muestra en el admin como
  /// aviso; el sitio público no lo lee nunca.
  reviewNote String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  images    VehicleImage[]
  inquiries Inquiry[]

  @@index([publicationStatus])
  @@index([vehicleType])
  @@index([make])
  @@index([model])
  @@index([categoryId])
  @@index([updatedAt])
  @@index([publicationStatus, createdAt])
  @@index([featured])
  @@index([availabilityStatus])
  @@index([year])
  @@index([price])
  @@index([mileage])
  @@index([fuelType])
  @@index([drivetrain])
  @@index([city])
  /// GIN: `tags @> ARRAY['Deportivo']` es la forma del filtro por carácter.
  /// `features` no lleva índice porque nada lo consulta: se lee con la ficha.
  @@index([tags], type: Gin)
}

/// `url` es lo que renderiza el sitio. `storagePath` solo existe para las
/// imágenes subidas a Supabase Storage, que son las únicas que el admin
/// puede borrar del bucket. `position` 0 es la portada.
model VehicleImage {
  id          String      @id @default(uuid()) @db.Uuid
  vehicleId   String      @db.Uuid
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url         String
  storagePath String?
  source      ImageSource @default(STORAGE)
  alt         String
  position    Int         @default(0)
  createdAt   DateTime    @default(now())

  @@unique([vehicleId, position])
  @@index([vehicleId])
}

// ---------------------------------------------------------------------------
// Solicitudes del público
// ---------------------------------------------------------------------------

/// `vehicleId` usa SetNull: archivar o borrar un vehículo nunca debe
/// destruir el registro de quién preguntó por él, así que se conserva
/// `vehicleLabel` con el nombre tal como se mostraba al enviarse.
model Inquiry {
  id           String        @id @default(uuid()) @db.Uuid
  type         InquiryType
  status       InquiryStatus @default(NEW)
  vehicleId    String?       @db.Uuid
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleLabel String?
  name         String
  phone        String
  email        String
  message      String?
  /// Página desde la que se envió: "contacto", "vehiculo:<slug>".
  source       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([vehicleId])
}

// ---------------------------------------------------------------------------
// Imágenes estructurales del sitio público
// ---------------------------------------------------------------------------

/// Las fotografías de la home que no pertenecen a ningún vehículo: el hero y
/// las tres de la historia de MILLE.
///
/// No es un CMS. `key` es una clave fija definida en src/lib/site-media.ts;
/// el admin cambia la fotografía de un slot existente, no crea slots. Una
/// fila que no corresponda a una clave conocida se ignora.
///
/// Solo existe fila para los slots que alguien ya cambió: mientras un slot
/// siga con su imagen original, el sitio la lee del registro en código. Por
/// eso ninguna fila es obligatoria y quedarse sin base de datos no deja la
/// home sin fotos.
model SiteMedia {
  id          String      @id @default(uuid()) @db.Uuid
  key         String      @unique
  url         String
  storagePath String?
  source      ImageSource @default(STORAGE)
  alt         String
  /// Qué parte de la fotografía debe permanecer visible cuando el marco la
  /// recorta, en porcentaje: 0 izquierda/arriba, 50 centro, 100 derecha/abajo.
  /// El centro es el valor con el que se construyó el sitio, así que una fila
  /// que nunca se haya encuadrado se sigue viendo exactamente igual.
  focalX      Float       @default(50)
  focalY      Float       @default(50)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Auditoría
// ---------------------------------------------------------------------------

/// Quién hizo qué. `adminUserId` es opcional para que revocar a alguien del
/// equipo no borre su historial.
model AdminAuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  adminUserId String?    @db.Uuid
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  adminEmail  String
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
